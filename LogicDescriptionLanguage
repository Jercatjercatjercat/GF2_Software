Logic Description Language

network         = devices_section , connections_section , monitors_section , "END" , ";" ;

devices_section = "DEVICES" , "{" , { device_decl } , "}" ;

device_decl     = switch_decl | clock_decl | gate_decl | dtype_decl | xor_decl ;

switch_decl     = device_name , ":" , "SWITCH" ,
                  "(" , "initial" , "=" , bit , ")" , ";" ;

clock_decl      = device_name , ":" , "CLOCK" ,
                  "(" , "period" , "=" , positive_integer , ")" , ";" ;

gate_decl       = device_name , ":" , gate_kind ,
                  "(" , "inputs" , "=" , positive_integer , ")" , ";" ;

dtype_decl      = device_name , ":" , "DTYPE" , ";" ;

xor_decl        = device_name , ":" , "XOR" , ";" ;

gate_kind       = "AND" | "NAND" | "OR" | "NOR" ;

connections_section = "CONNECT" , "{" , { connection_decl } , "}" ;

connection_decl = output_signal , "->" , input_signal , ";" ;

monitors_section = "MONITOR" , "{" , [ output_signal , { "," , output_signal } ] , "}" , ";" ;

input_signal    = device_name , "." , input_name ;

output_signal   = device_name , [ "." , output_name ] ;

device_name     = letter , { letter | digit | "_" } ;

input_name      = letter , { letter | digit } ;

output_name     = letter , { letter | digit } ;

positive_integer = non_zero_digit , { digit } ;

bit             = "0" | "1" ;

letter          = "A" | ... | "Z" | "a" | ... | "z" ;

digit           = "0" | ... | "9" ;

non_zero_digit  = "1" | ... | "9" ;


Example Definition File:

DEVICES {
    SW1 : SWITCH(initial = 0);
    SW2 : SWITCH(initial = 1);

    G1 : NAND(inputs = 2);
    G2 : NAND(inputs = 2);
}

CONNECT {
    SW1 -> G1.I1;
    SW2 -> G2.I2;
    G1  -> G2.I1;
    G2  -> G1.I2;
}

MONITOR {
    G1, G2
};

END;
